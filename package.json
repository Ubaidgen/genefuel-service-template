{
  "name": "genefuel-service-template",
  "version": "0.1.0",
  "description": "Starting template for every new GeneFuel backend service (NestJS, Drizzle, Postgres)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "check-types": "tsc --noEmit",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:all": "npm run test && npm run test:e2e",
    "verify": "npm run lint && npm run check-types && npm run lint:boundaries && npm run test:all",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node dist/core/db/migrate.js",
    "db:migrate:dev": "tsx src/core/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "new:module": "tsx scripts/new-module.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.4.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}
