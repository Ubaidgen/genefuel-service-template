# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# Production values come from the secret manager — see docs/SECURITY.md.

NODE_ENV=development
PORT=3000
SERVICE_NAME=service-template
LOG_LEVEL=debug

# Reverse-proxy hops in front of the service (0 locally; 1 behind one load balancer).
TRUST_PROXY_HOPS=0
# Browser origins allowed to call this service with credentials (comma-separated, exact).
CORS_ORIGINS=http://localhost:3001
BODY_LIMIT=100kb

# docker compose up -d
DATABASE_URL=postgres://service:service@127.0.0.1:54329/service_template
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Required in production (shared rate limits across instances).
REDIS_URL=redis://127.0.0.1:63799
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# genefuel-web-app origin: member/staff sessions are verified via GET /api/auth/me.
AUTH_BASE_URL=http://localhost:3001
AUTH_SESSION_CACHE_TTL_MS=15000
AUTH_TIMEOUT_MS=3000

# Service-to-service JWT (HS256). Generate: openssl rand -base64 48
SERVICE_TOKEN_SECRET=replace-me-with-openssl-rand-base64-48-output
# Services allowed to call this one (their SERVICE_NAME), comma-separated.
SERVICE_TOKEN_ISSUERS=genefuel-web-app
SERVICE_TOKEN_MAX_TTL_SECONDS=300

# Field encryption keyring "v<N>:<base64 32 bytes>". Generate a key: openssl rand -base64 32
FIELD_CRYPTO_KEYS=v1:replace-with-openssl-rand-base64-32=
FIELD_CRYPTO_ACTIVE_KEY_ID=v1
